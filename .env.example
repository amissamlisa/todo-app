# Active app environment variables
JWT_SECRET_KEY=your-secret-key-change-this-in-production
OPENAI_API_KEY=your-openai-api-key
SQLALCHEMY_DATABASE_URL=postgresql://postgres:change-me-local@localhost:5432/TodoAppDatabase
RESEND_API_KEY=your-resend-api-key
PASSWORD_RESET_URL=https://your-frontend-domain.com/password-reset
ALLOWED_ORIGIN_URL=https://your-frontend-domain.com
COOKIE_SECURE=false
DB_USER=postgres
DB_PASSWORD=change-me-local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=TodoAppDatabase

# Optional backend variables
OPENAI_TIMEOUT_SECONDS=600
SQLALCHEMY_ECHO=false

# Frontend (Vite)
VITE_API_BASE_URL=https://your-api-domain.com

# Local development examples
# PASSWORD_RESET_URL=http://localhost:3000/password-reset
# ALLOWED_ORIGIN_URL=http://localhost:3000
# VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL (docker-compose-only variables)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me-local
# POSTGRES_DB=TodoAppDatabase

# Alembic (optional)
# ALEMBIC_DATABASE_URL=postgresql://postgres:password@localhost:5432/TodoAppDatabase
# ALEMBIC_TARGET_DB=production
# SQLALCHEMY_PRODUCTION_DATABASE_URL=postgresql://postgres:password@localhost:5432/TodoAppDatabase

# Backend tests (used when SQLALCHEMY_DATABASE_URL is not set)
# DB_USER=postgres
# DB_PASSWORD=change-me-local
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=TodoAppDatabase
