# PostgreSQL (for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=TodoAppDatabase

# FastAPI backend environment variables
JWT_SECRET_KEY=your-secret-key-change-this-in-production
PASSWORD_RESET_URL=http://localhost:3000
SENDER_ADDRESS=your-email@example.com
SENDER_ADDRESS_PASSWORD=your-app-password
ALLOWED_ORIGIN_URL=http://localhost:3000
COOKIE_SECURE=false
OPENAI_API_KEY=your-openai-api-key

# PostgreSQL is configured in docker-compose.yml
# SQLALCHEMY_DATABASE_URL is set automatically in docker-compose.yml
# If you run backend without docker-compose, set SQLALCHEMY_DATABASE_URL manually.
# SQLALCHEMY_DATABASE_URL=postgresql://postgres:password@localhost:5432/TodoAppDatabase
